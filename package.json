{
  "name": "spectrum-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Spectrum Group CRM & Agile Platform \u2014 crm.spectrumgroup.id",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:policy": "tsc -p scripts/tsconfig.json && node scripts/.out/scripts/verify-policy.js",
    "postinstall": "node scripts/workers-ci-postinstall.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply spectrum-crm --local",
    "db:migrate:remote": "wrangler d1 migrations apply spectrum-crm --remote",
    "db:seed-sql": "tsc -p scripts/tsconfig.json && node scripts/.out/scripts/generate-seed-sql.js",
    "db:seed:local": "wrangler d1 execute spectrum-crm --local --file=drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute spectrum-crm --remote --file=drizzle/seed.sql"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@opennextjs/cloudflare": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.41.0",
    "lucide-react": "^0.475.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "wrangler": "^4.20.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
